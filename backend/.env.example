# ========== SERVER ==========
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo  # Timezone Brasil (UTC-3) # development | production

# ========== SUPABASE ==========
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXX
SUPABASE_SERVICE_KEY=sb_secret_XXX

# ========== DATABASE (Supabase PostgreSQL) ==========
# URL via PgBouncer (porta 6543) - para queries do dia-a-dia
DATABASE_URL=postgresql://postgres.guefylolrzzhdahizhdr:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# URL de conexão direta (porta 5432) - para migrations Prisma
DIRECT_URL=postgresql://postgres.guefylolrzzhdahizhdr:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ========== AUTH (JWT) ==========
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_super_segura_aqui_mude_isso

# ========== STORAGE (Supabase Storage) ==========
STORAGE_BUCKET_DOCUMENTOS=documentos
STORAGE_BUCKET_THUMBNAILS=thumbnails

# ========== APIs EXTERNAS ==========
# CNPJ API (opcional - para fallback)
INVERTEXTO_TOKEN=SEU_TOKEN_AQUI

# OCR.space (para OCR de PDFs escaneados)
OCR_SPACE_API_KEY=SEU_TOKEN_AQUI

# ========== LOGGING ==========
LOG_LEVEL=info # error | warn | info | debug

# ========== OPCIONAL - REMOVER APÓS MIGRAÇÃO ==========
# MONGODB_URI=mongodb+srv://user:senha@cluster.mongodb.net/banco?retryWrites=true&w=majority
