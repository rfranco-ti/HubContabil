generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  nome                String
  email               String               @unique
  senha               String
  cargo               String               @default("Contador")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  refreshToken        String?              @map("refresh_token")
  assinatura_texto    String?
  cargo_responsavel   String?
  carimbo_url         String?
  cpf_responsavel     String?
  agendamentosCriados AgendamentoRpa[]     @relation("AgendamentoCriadoPor")
  agendamentos        AgendamentoRpa[]
  apiKeys             ApiKey[]
  calculos_salvos     calculos_salvos[]
  calendarioEventos   CalendarioEvento[]
  clientsResponsable  Client[]             @relation("UsuarioResponsavel")
  documentosUploaded  Documento[]          @relation("DocumentoUploadedBy")
  documentos_gerados  documentos_gerados[]
  notificacoes        Notificacao[]
  pastasCriadas       PastaDocumento[]     @relation("PastaCriadaPor")
  pastasNotas         PastaNota[]
  stickyNotes         StickyNote[]
  templatesCriados    Template[]           @relation("TemplateCriadoPor")

  @@map("users")
}

model Client {
  id                      String           @id @default(uuid()) @db.Uuid
  cnpj                    String           @unique
  razaoSocial             String           @map("razao_social")
  nomeFantasia            String?          @map("nome_fantasia")
  dataAbertura            String?          @map("data_abertura")
  naturezaJuridica        String?          @map("natureza_juridica")
  inscricaoEstadual       String?          @map("inscricao_estadual")
  inscricaoMunicipal      String?          @map("inscricao_municipal")
  nire                    String?          @map("nire")
  situacaoSefaz           String?          @map("situacao_sefaz")
  regimeTributario        String           @default("Outro") @map("regime_tributario")
  cnaePrincipalCodigo     String?          @map("cnae_principal_codigo")
  cnaePrincipalDescricao  String?          @map("cnae_principal_descricao")
  enderecoCep             String?          @map("endereco_cep")
  enderecoLogradouro      String?          @map("endereco_logradouro")
  enderecoNumero          String?          @map("endereco_numero")
  enderecoComplemento     String?          @map("endereco_complemento")
  enderecoBairro          String?          @map("endereco_bairro")
  enderecoCidade          String?          @map("endereco_cidade")
  enderecoUf              String?          @map("endereco_uf")
  contatoEmail            String?          @map("contato_email")
  contatoTelefone         String?          @map("contato_telefone")
  senhasPortais           Json?            @default("{}") @map("senhas_portais")
  certificadoPossui       Boolean          @default(false) @map("certificado_possui")
  certificadoSenha        String?          @map("certificado_senha")
  certificadoEmissao      DateTime?        @map("certificado_emissao")
  certificadoVencimento   DateTime?        @map("certificado_vencimento")
  honorariosValor         Decimal          @default(0) @map("honorarios_valor") @db.Decimal(10, 2)
  honorariosDiaVencimento Int?             @map("honorarios_dia_vencimento")
  servicosPrestados       String?          @map("servicos_prestados")
  temContabil             Boolean          @default(false) @map("tem_contabil")
  temFiscal               Boolean          @default(false) @map("tem_fiscal")
  temDp                   Boolean          @default(false) @map("tem_dp")
  categoria               String           @default("Serviços")
  isBpo                   Boolean          @default(false) @map("is_bpo")
  isMei                   Boolean          @default(false) @map("is_mei")
  capitalSocial           Decimal          @default(0) @map("capital_social") @db.Decimal(20, 2)
  porte                   String?          @map("porte")
  situacaoData            String?          @map("situacao_data")
  situacaoMotivo          String?          @map("situacao_motivo")
  opcaoSimples            Boolean          @default(false) @map("opcao_simples")
  dataOpcaoSimples        String?          @map("data_opcao_simples")
  dataExclusaoSimples     String?          @map("data_exclusao_simples")
  motivoExclusaoSimples   String?          @map("motivo_exclusao_simples")
  dataOpcaoMei            String?          @map("data_opcao_mei")
  dataExclusaoMei         String?          @map("data_exclusao_mei")
  observacoes             String?
  status                  String           @default("Ativo")
  usuarioResponsavelId    String?          @map("usuario_responsavel_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  cnaesSecundarios        CnaeSecundario[]
  qsa                     ClientQsa[]
  usuarioResponsavel      User?            @relation("UsuarioResponsavel", fields: [usuarioResponsavelId], references: [id])
  contatos                Contato[]
  documentos              Documento[]
  pastas                  PastaDocumento[]
  reciboModelos           ReciboModelo[]
  recibos                 Recibo[]
  templates               Template[]

  @@index([cnpj])
  @@index([razaoSocial])
  @@index([status])
  @@index([usuarioResponsavelId])
  @@map("clients")
}

model CnaeSecundario {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  codigo    String
  descricao String
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_cnaes_secundarios")
}

model ClientQsa {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  nome         String
  cpfCnpj      String?  @map("cpf_cnpj")
  qualificacao String
  participacao Decimal? @db.Decimal(20, 2)
  dataEntrada  String?  @map("data_entrada")
  pais         String?  @map("pais")
  representanteLegal String? @map("representante_legal")
  createdAt    DateTime @default(now()) @map("created_at")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_qsa")
}

model Contato {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  nome        String   @map("nome")
  email       String?  @map("email")
  telefone    String?  @map("telefone")
  cargo       String?  @map("cargo")
  ehPrincipal Boolean  @default(false) @map("eh_principal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("contatos")
}

model PastaDocumento {
  id          String           @id @default(uuid()) @db.Uuid
  clientId    String           @map("client_id") @db.Uuid
  nome        String
  descricao   String?
  pastaPaiId  String?          @map("pasta_pai_id") @db.Uuid
  criadaPorId String?          @map("criada_por_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  documentos  Documento[]
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  criadaPor   User?            @relation("PastaCriadaPor", fields: [criadaPorId], references: [id])
  pastaPai    PastaDocumento?  @relation("PastaHierarquia", fields: [pastaPaiId], references: [id])
  filhos      PastaDocumento[] @relation("PastaHierarquia")

  @@index([clientId])
  @@index([pastaPaiId])
  @@map("pasta_documentos")
}

model Documento {
  id                   String          @id @default(uuid()) @db.Uuid
  clientId             String          @map("client_id") @db.Uuid
  nomeOriginal         String          @map("nome_original")
  nomeArquivo          String          @map("nome_arquivo")
  storagePath          String          @map("storage_path")
  thumbnailPath        String?         @map("thumbnail_path")
  mimetype             String
  tamanhoBytes         Int             @map("tamanho_bytes")
  tamanhoOriginalBytes Int?            @map("tamanho_original_bytes")
  tipo                 String          @default("documento")
  status               DocumentoStatus @default(PENDENTE)
  descricao            String?
  pastaId              String?         @map("pasta_id") @db.Uuid
  ocrRealizado         Boolean         @default(false) @map("ocr_realizado")
  ocrTexto             String?         @map("ocr_texto")
  uploadedById         String?         @map("uploaded_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pasta                PastaDocumento? @relation(fields: [pastaId], references: [id])
  uploadedBy           User?           @relation("DocumentoUploadedBy", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([pastaId])
  @@index([tipo])
  @@index([ocrRealizado])
  @@map("documentos")
}

model ReciboModelo {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  nome      String
  tipo      String
  isDefault Boolean  @default(false) @map("is_default")
  estrutura Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  clientId  String?  @db.Uuid
  Client    Client?  @relation(fields: [clientId], references: [id])
  Recibo    Recibo[]

  @@index([usuarioId])
  @@index([tipo])
  @@map("recibo_modelos")
}

model Recibo {
  id        String        @id @default(uuid()) @db.Uuid
  usuarioId String        @map("usuario_id") @db.Uuid
  clienteId String        @map("cliente_id") @db.Uuid
  modeloId  String?       @map("modelo_id") @db.Uuid
  tipo      String
  dados     Json
  pdfUrl    String?       @map("pdf_url")
  valor     Decimal       @map("valor") @db.Decimal(10, 2)
  status    String        @default("gerado")
  createdAt DateTime      @default(now()) @map("created_at")
  codigo    String?
  gerado_em DateTime?
  cliente   Client        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  modelo    ReciboModelo? @relation(fields: [modeloId], references: [id])

  @@index([clienteId])
  @@index([usuarioId])
  @@map("recibos")
}

model Template {
  id        String           @id @default(uuid()) @db.Uuid
  nome      String
  tipo      String
  descricao String?
  estrutura Json
  thumbnail String?
  usuarioId String?          @map("usuario_id") @db.Uuid
  clienteId String?          @map("cliente_id") @db.Uuid
  isDefault Boolean          @default(false) @map("is_default")
  isPublic  Boolean          @default(false) @map("is_public")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  versoes   TemplateVersao[]
  cliente   Client?          @relation(fields: [clienteId], references: [id])
  usuario   User?            @relation("TemplateCriadoPor", fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([clienteId])
  @@index([tipo])
  @@map("templates")
}

model TemplateVersao {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  versao     Int      @default(1)
  estrutura  Json
  alteracoes String?
  createdAt  DateTime @default(now()) @map("created_at")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_versoes")
}

model StickyNote {
  id           String     @id @default(uuid()) @db.Uuid
  usuarioId    String     @map("usuario_id") @db.Uuid
  titulo       String
  conteudo     String?
  cor          String     @default("yellow")
  ordem        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  dataLembrete DateTime?  @map("data_lembrete")
  lembrete     Boolean    @default(false)
  pastaId      String?    @map("pasta_id") @db.Uuid
  dataFixacao  DateTime?  @map("data_fixacao")
  fixada       Boolean    @default(false)
  pasta        PastaNota? @relation(fields: [pastaId], references: [id])
  usuario      User       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ordem])
  @@index([lembrete])
  @@index([fixada])
  @@index([pastaId])
  @@map("sticky_notes")
}

model PastaNota {
  id        String       @id @default(uuid()) @db.Uuid
  usuarioId String       @map("usuario_id") @db.Uuid
  nome      String
  cor       String       @default("blue")
  ordem     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  usuario   User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  notas     StickyNote[]

  @@index([usuarioId])
  @@index([ordem])
  @@map("pastas_notas")
}

model TipoEvento {
  id           String                @id @default(uuid()) @db.Uuid
  nome         String                @unique
  label        String
  cor          String                @default("#3b82f6")
  icone        String?
  descricao    String?
  ativo        Boolean               @default(true)
  ordem        Int                   @default(0)
  createdAt    DateTime              @default(now()) @map("created_at")
  ehPadrao     Boolean               @default(false)
  eventos      CalendarioEvento[]
  obrigacoes   CalendarioObrigacao[]
  notificacoes Notificacao[]

  @@index([ativo])
  @@index([ehPadrao])
  @@map("tipos_evento")
}

model CalendarioEvento {
  id        String      @id @default(uuid()) @db.Uuid
  usuarioId String      @map("usuario_id") @db.Uuid
  titulo    String
  descricao String?
  data      DateTime
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  cor       String      @default("#3b82f6")
  lembrete  Boolean     @default(false)
  municipio String?     @map("municipio")
  tipoId    String?     @map("tipo_id") @db.Uuid
  uf        String?
  tipo      TipoEvento? @relation(fields: [tipoId], references: [id])
  usuario   User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([data])
  @@index([tipoId])
  @@map("calendario_eventos")
}

model CnpjCache {
  id        String    @id @default(uuid()) @db.Uuid
  cnpj      String    @unique
  dados     Json
  createdAt DateTime  @default(now()) @map("created_at")
  fonte     String?   @default("open_cnpja")
  updatedAt DateTime  @default(now()) @map("updated_at")
  validoAte DateTime? @map("valido_ate")

  @@index([cnpj])
  @@index([validoAte])
  @@map("cnpj_cache")
}

model CalendarioObrigacao {
  id                 String      @id @default(uuid()) @db.Uuid
  ano                Int
  mes                Int
  dia                Int
  nomeEvento         String      @map("nome_evento")
  periodoApuracao    String?     @map("periodo_apuracao")
  baseLegal          String?     @map("base_legal")
  categoria          String
  isFeriado          Boolean     @default(false) @map("is_feriado")
  isPontoFacultativo Boolean     @default(false) @map("is_ponto_facultativo")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  tipoEventoId       String?     @map("tipo_evento_id") @db.Uuid
  tipoEvento         TipoEvento? @relation(fields: [tipoEventoId], references: [id])

  @@index([ano])
  @@index([mes])
  @@index([categoria])
  @@index([isFeriado])
  @@index([tipoEventoId])
  @@map("calendario_obrigacoes")
}

model CalendarioFeriado {
  id           String             @id @default(uuid()) @db.Uuid
  data         DateTime           @unique
  nome         String
  municipio    String?
  ano          Int
  createdAt    DateTime           @default(now()) @map("created_at")
  abrangencia  AbrangenciaFeriado @default(NACIONAL)
  descricao    String?
  recorrente   Boolean            @default(true)
  setorAfetado String[]           @default(["geral"])
  uf           String?
  updatedAt    DateTime           @default(now()) @map("updated_at")

  @@index([ano])
  @@index([abrangencia])
  @@index([uf])
  @@index([data])
  @@map("calendario_feriados")
}

model Notificacao {
  id            String      @id @default(uuid()) @db.Uuid
  usuarioId     String      @map("usuario_id") @db.Uuid
  titulo        String
  mensagem      String
  tipoEventoId  String?     @map("tipo_evento_id") @db.Uuid
  eventoId      String?     @map("evento_id") @db.Uuid
  tipoAlerta    TipoAlerta  @map("tipo_alerta")
  lida          Boolean     @default(false)
  dataEnvio     DateTime    @default(now()) @map("data_envio")
  dataExpiracao DateTime?   @map("data_expiracao")
  metadata      Json?       @default("{}")
  createdAt     DateTime    @default(now()) @map("created_at")
  tipoEvento    TipoEvento? @relation(fields: [tipoEventoId], references: [id])
  usuario       User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([lida])
  @@index([tipoAlerta])
  @@index([dataEnvio])
  @@index([dataExpiracao])
  @@map("notificacoes")
}

model AgendamentoRpa {
  id              String                 @id @default(uuid()) @db.Uuid
  usuarioId       String                 @map("usuario_id") @db.Uuid
  nome            String
  tipoRobo        TipoRobo               @map("tipo_robo")
  cnpj            String
  recorrencia     RecorrenciaAgendamento
  diasSemana      Int?                   @map("dias_semana")
  horaExecucao    String                 @map("hora_execucao")
  vezesPorDia     Int                    @default(1) @map("vezes_por_dia")
  vezesPorSemana  Int                    @default(0) @map("vezes_por_semana")
  proximaExecucao DateTime?              @map("proxima_execucao")
  ativo           Boolean                @default(true)
  ultimoResultado Json?                  @default("{}") @map("ultimo_resultado")
  totalExecucoes  Int                    @default(0) @map("total_execucoes")
  criadoPorId     String?                @map("criado_por_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  criadoPor       User?                  @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id])
  usuario         User                   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ativo])
  @@index([tipoRobo])
  @@index([recorrencia])
  @@index([proximaExecucao])
  @@map("agendamentos_rpa")
}

model ApiKey {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  nome             String
  chave            String    @unique
  prefixo          String
  permissoes       Json      @default("[]")
  ultimaUtilizacao DateTime? @map("ultima_utilizacao")
  totalRequisicoes Int       @default(0) @map("total_requisicoes")
  expiraEm         DateTime? @map("expira_em")
  ativa            Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  usuario          User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ativa])
  @@index([chave])
  @@map("api_keys")
}

model CnpjApiConfig {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String   @unique
  label          String
  url            String
  ativa          Boolean  @default(true)
  ordem          Int
  consomeCredito Boolean  @default(false)
  timeout        Int      @default(5000)
  cbThreshold    Int      @default(5)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ordem])
  @@index([ativa])
  @@map("cnpj_api_config")
}

model audit_log {
  id          String   @id @db.Uuid
  calculo_id  String?  @db.Uuid
  user_id     String?  @db.Uuid
  acao        String
  metadata    Json?
  ip          String?
  user_agent  String?
  token_usado String?
  created_at  DateTime @default(now())

  @@index([calculo_id])
  @@index([created_at])
  @@index([user_id])
}

model biblioteca_clausulas {
  id         String   @id @db.Uuid
  user_id    String?  @db.Uuid
  titulo     String
  conteudo   String
  categoria  String
  is_global  Boolean  @default(true)
  ordem      Int      @default(0)
  created_at DateTime @default(now())

  @@index([categoria])
  @@index([user_id])
}

model calculos_salvos {
  id                String              @id @db.Uuid
  user_id           String              @db.Uuid
  nome              String
  calculo_tipo      String
  payload           Json
  hash_sha256       String              @default("")
  created_at        DateTime            @default(now())
  updated_at        DateTime
  users             User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  compartilhamentos compartilhamentos[]

  @@index([calculo_tipo])
  @@index([user_id])
}

model compartilhamentos {
  id                       String          @id @db.Uuid
  calculo_id               String          @db.Uuid
  criado_por               String          @db.Uuid
  token                    String          @unique
  expira_em                DateTime
  permitir_dados_completos Boolean         @default(false)
  ativo                    Boolean         @default(true)
  created_at               DateTime        @default(now())
  calculos_salvos          calculos_salvos @relation(fields: [calculo_id], references: [id], onDelete: Cascade)

  @@index([calculo_id])
  @@index([token])
}

model documentos_gerados {
  id                       String               @id @db.Uuid
  user_id                  String               @db.Uuid
  client_id                String?              @db.Uuid
  parent_id                String?              @db.Uuid
  tipo_documento           String
  titulo                   String
  payload                  Json
  status                   String               @default("finalizado")
  carimbo_aplicado         Boolean              @default(false)
  acoes_log                Json                 @default("[]")
  created_at               DateTime             @default(now())
  updated_at               DateTime
  documentos_gerados       documentos_gerados?  @relation("documentos_geradosTodocumentos_gerados", fields: [parent_id], references: [id])
  other_documentos_gerados documentos_gerados[] @relation("documentos_geradosTodocumentos_gerados")
  users                    User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tipo_documento])
  @@index([user_id])
}

model recibo_sequences {
  date      String   @id
  seq       Int      @default(0)
  updatedAt DateTime
}

enum AbrangenciaFeriado {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

enum TipoAlerta {
  TRES_DIAS_ANTES
  DOIS_DIAS_ANTES
  UM_DIA_ANTE
  DOZE_HORAS_ANTES
  NO_DIA
}

enum TipoRobo {
  SIMPLES_NACIONAL
  SEFAZ_BA
}

enum RecorrenciaAgendamento {
  unica
  diaria
  semanal
  mensal
  x_vezes_dia
