{
  "watch": [
    "src",
    "index.js",
    ".env"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "logs",
    "uploads",
    "temp",
    "*.test.js",
    "*.spec.js"
  ],
  "delay": "1000",
  "events": {
    "restart": "echo '🔄 Backend reiniciado automaticamente!'"
  },
  "verbose": true,
  "env": {
    "NODE_ENV": "development"
  }
}
