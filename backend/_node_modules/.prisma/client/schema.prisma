// Enums para o sistema de calendário

enum AbrangenciaFeriado {
  NACIONAL
  ESTADUAL
  MUNICIPAL
}

enum TipoAlerta {
  UM_DIA_ANTE
  NO_DIA
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  nome                String
  email               String             @unique
  senha               String
  cargo               String             @default("Contador")
  refreshToken        String?            @map("refresh_token")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  calendarioEventos   CalendarioEvento[]
  clientsResponsable  Client[]           @relation("UsuarioResponsavel")
  documentosUploaded  Documento[]        @relation("DocumentoUploadedBy")
  pastasCriadas       PastaDocumento[]   @relation("PastaCriadaPor")
  stickyNotes         StickyNote[]
  pastasNotas         PastaNota[]
  templatesCriados    Template[]         @relation("TemplateCriadoPor")
  notificacoes        Notificacao[]
  agendamentosCriados AgendamentoRpa[]   @relation("AgendamentoCriadoPor")
  agendamentos        AgendamentoRpa[]
  apiKeys             ApiKey[]

  @@map("users")
}

model Client {
  id                      String           @id @default(uuid()) @db.Uuid
  cnpj                    String           @unique
  razaoSocial             String           @map("razao_social")
  nomeFantasia            String?          @map("nome_fantasia")
  dataAbertura            String?          @map("data_abertura")
  naturezaJuridica        String?          @map("natureza_juridica")
  inscricaoEstadual       String?          @map("inscricao_estadual")
  inscricaoMunicipal      String?          @map("inscricao_municipal")
  nire                    String?          @map("nire")
  situacaoSefaz           String?          @map("situacao_sefaz")
  regimeTributario        String           @default("Outro") @map("regime_tributario")
  cnaePrincipalCodigo     String?          @map("cnae_principal_codigo")
  cnaePrincipalDescricao  String?          @map("cnae_principal_descricao")
  enderecoCep             String?          @map("endereco_cep")
  enderecoLogradouro      String?          @map("endereco_logradouro")
  enderecoNumero          String?          @map("endereco_numero")
  enderecoComplemento     String?          @map("endereco_complemento")
  enderecoBairro          String?          @map("endereco_bairro")
  enderecoCidade          String?          @map("endereco_cidade")
  enderecoUf              String?          @map("endereco_uf")
  contatoEmail            String?          @map("contato_email")
  contatoTelefone         String?          @map("contato_telefone")
  senhasPortais           Json?            @default("{}") @map("senhas_portais")
  certificadoPossui       Boolean          @default(false) @map("certificado_possui")
  certificadoSenha        String?          @map("certificado_senha")
  certificadoVencimento   DateTime?        @map("certificado_vencimento")
  honorariosValor         Decimal          @default(0) @map("honorarios_valor") @db.Decimal(10, 2)
  honorariosDiaVencimento Int?             @map("honorarios_dia_vencimento")
  categoria               String           @default("Serviços")
  isBpo                   Boolean          @default(false) @map("is_bpo")
  observacoes             String?
  status                  String           @default("Ativo")
  usuarioResponsavelId    String?          @map("usuario_responsavel_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  cnaesSecundarios        CnaeSecundario[]
  qsa                     ClientQsa[]
  usuarioResponsavel      User?            @relation("UsuarioResponsavel", fields: [usuarioResponsavelId], references: [id])
  contatos                Contato[]
  documentos              Documento[]
  pastas                  PastaDocumento[]
  reciboModelos           ReciboModelo[]
  recibos                 Recibo[]
  templates               Template[]

  @@index([cnpj])
  @@index([razaoSocial])
  @@index([status])
  @@index([usuarioResponsavelId])
  @@map("clients")
}

model CnaeSecundario {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  codigo    String
  descricao String
  createdAt DateTime @default(now()) @map("created_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_cnaes_secundarios")
}

model ClientQsa {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  nome         String
  cpfCnpj      String?  @map("cpf_cnpj")
  qualificacao String
  participacao Decimal? @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_qsa")
}

model Contato {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  nome        String   @map("nome")
  email       String?  @map("email")
  telefone    String?  @map("telefone")
  cargo       String?  @map("cargo")
  ehPrincipal Boolean  @default(false) @map("eh_principal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("contatos")
}

model PastaDocumento {
  id          String           @id @default(uuid()) @db.Uuid
  clientId    String           @map("client_id") @db.Uuid
  nome        String
  descricao   String?
  pastaPaiId  String?          @map("pasta_pai_id") @db.Uuid
  criadaPorId String?          @map("criada_por_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  documentos  Documento[]
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  criadaPor   User?            @relation("PastaCriadaPor", fields: [criadaPorId], references: [id])
  pastaPai    PastaDocumento?  @relation("PastaHierarquia", fields: [pastaPaiId], references: [id])
  filhos      PastaDocumento[] @relation("PastaHierarquia")

  @@index([clientId])
  @@index([pastaPaiId])
  @@map("pasta_documentos")
}

model Documento {
  id                   String          @id @default(uuid()) @db.Uuid
  clientId             String          @map("client_id") @db.Uuid
  nomeOriginal         String          @map("nome_original")
  nomeArquivo          String          @map("nome_arquivo")
  storagePath          String          @map("storage_path")
  thumbnailPath        String?         @map("thumbnail_path")
  mimetype             String
  tamanhoBytes         Int             @map("tamanho_bytes")
  tamanhoOriginalBytes Int?            @map("tamanho_original_bytes")
  tipo                 String          @default("documento")
  descricao            String?
  pastaId              String?         @map("pasta_id") @db.Uuid
  ocrRealizado         Boolean         @default(false) @map("ocr_realizado")
  ocrTexto             String?         @map("ocr_texto")
  uploadedById         String?         @map("uploaded_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pasta                PastaDocumento? @relation(fields: [pastaId], references: [id])
  uploadedBy           User?           @relation("DocumentoUploadedBy", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([pastaId])
  @@index([tipo])
  @@index([ocrRealizado])
  @@map("documentos")
}

model ReciboModelo {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  nome      String
  tipo      String
  isDefault Boolean  @default(false) @map("is_default")
  estrutura Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  clientId  String?  @db.Uuid
  Client    Client?  @relation(fields: [clientId], references: [id])
  Recibo    Recibo[]

  @@index([usuarioId])
  @@index([tipo])
  @@map("recibo_modelos")
}

model Recibo {
  id        String        @id @default(uuid()) @db.Uuid
  usuarioId String        @map("usuario_id") @db.Uuid
  clienteId String        @map("cliente_id") @db.Uuid
  modeloId  String?       @map("modelo_id") @db.Uuid
  tipo      String
  dados     Json
  pdfUrl    String?       @map("pdf_url")
  valor     Decimal       @map("valor") @db.Decimal(10, 2)
  status    String        @default("gerado")
  createdAt DateTime      @default(now()) @map("created_at")
  cliente   Client        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  modelo    ReciboModelo? @relation(fields: [modeloId], references: [id])

  @@index([clienteId])
  @@index([usuarioId])
  @@map("recibos")
}

model Template {
  id        String           @id @default(uuid()) @db.Uuid
  nome      String
  tipo      String
  descricao String?
  estrutura Json
  thumbnail String?
  usuarioId String?          @map("usuario_id") @db.Uuid
  clienteId String?          @map("cliente_id") @db.Uuid
  isDefault Boolean          @default(false) @map("is_default")
  isPublic  Boolean          @default(false) @map("is_public")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  versoes   TemplateVersao[]
  cliente   Client?          @relation(fields: [clienteId], references: [id])
  usuario   User?            @relation("TemplateCriadoPor", fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([clienteId])
  @@index([tipo])
  @@map("templates")
}

model TemplateVersao {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  versao     Int      @default(1)
  estrutura  Json
  alteracoes String?
  createdAt  DateTime @default(now()) @map("created_at")
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_versoes")
}

model StickyNote {
  id           String     @id @default(uuid()) @db.Uuid
  usuarioId    String     @map("usuario_id") @db.Uuid
  titulo       String
  conteudo     String?
  cor          String     @default("yellow")
  ordem        Int        @default(0)
  lembrete     Boolean    @default(false)
  dataLembrete DateTime?  @map("data_lembrete")
  fixada       Boolean    @default(false)
  dataFixacao  DateTime?  @map("data_fixacao")
  pastaId      String?    @map("pasta_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  usuario      User       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pasta        PastaNota? @relation(fields: [pastaId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([ordem])
  @@index([lembrete])
  @@index([fixada])
  @@index([pastaId])
  @@map("sticky_notes")
}

model PastaNota {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  nome      String
  cor       String   @default("blue")
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notas   StickyNote[]
  usuario User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ordem])
  @@map("pastas_notas")
}

model TipoEvento {
  id           String                @id @default(uuid()) @db.Uuid
  nome         String                @unique // slug: 'trabalhista', 'tributario', 'feriado', etc.
  label        String // label exibível: 'Trabalhista', 'Tributário', etc.
  cor          String                @default("#3b82f6")
  icone        String?
  descricao    String?
  ativo        Boolean               @default(true)
  ordem        Int                   @default(0)
  ehPadrao     Boolean               @default(false) // true = tipos fixos do sistema, false = customizados pelo admin
  createdAt    DateTime              @default(now()) @map("created_at")
  eventos      CalendarioEvento[]
  obrigacoes   CalendarioObrigacao[]
  notificacoes Notificacao[]

  @@index([ativo])
  @@index([ehPadrao])
  @@map("tipos_evento")
}

model CalendarioEvento {
  id        String      @id @default(uuid()) @db.Uuid
  usuarioId String      @map("usuario_id") @db.Uuid
  titulo    String
  descricao String?
  data      DateTime
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  cor       String      @default("#3b82f6")
  lembrete  Boolean     @default(false)
  municipio String?     @map("municipio")
  tipoId    String?     @map("tipo_id") @db.Uuid
  uf        String?
  tipo      TipoEvento? @relation(fields: [tipoId], references: [id])
  usuario   User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([data])
  @@index([tipoId])
  @@map("calendario_eventos")
}

model CnpjCache {
  id        String    @id @default(uuid()) @db.Uuid
  cnpj      String    @unique
  dados     Json
  createdAt DateTime  @default(now()) @map("created_at")
  fonte     String?   @default("open_cnpja")
  updatedAt DateTime  @default(now()) @map("updated_at")
  validoAte DateTime? @map("valido_ate")

  @@index([cnpj])
  @@index([validoAte])
  @@map("cnpj_cache")
}

model CalendarioObrigacao {
  id                 String      @id @default(uuid()) @db.Uuid
  ano                Int
  mes                Int
  dia                Int
  nomeEvento         String      @map("nome_evento")
  periodoApuracao    String?     @map("periodo_apuracao")
  baseLegal          String?     @map("base_legal")
  categoria          String
  isFeriado          Boolean     @default(false) @map("is_feriado")
  isPontoFacultativo Boolean     @default(false) @map("is_ponto_facultativo")
  tipoEventoId       String?     @map("tipo_evento_id") @db.Uuid
  tipoEvento         TipoEvento? @relation(fields: [tipoEventoId], references: [id])
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([ano])
  @@index([mes])
  @@index([categoria])
  @@index([isFeriado])
  @@index([tipoEventoId])
  @@map("calendario_obrigacoes")
}

model CalendarioFeriado {
  id           String             @id @default(uuid()) @db.Uuid
  data         DateTime           @unique
  nome         String
  abrangencia  AbrangenciaFeriado @default(NACIONAL) // NACIONAL, ESTADUAL, MUNICIPAL
  uf           String? // para feriados estaduais
  municipio    String? // para feriados municipais
  ano          Int
  recorrente   Boolean            @default(true) // se true, repete todo ano automaticamente
  setorAfetado String[]           @default(["geral"]) // quais setores são impactados: tributario, trabalhista, geral, etc.
  descricao    String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @default(now()) @map("updated_at")

  @@index([ano])
  @@index([abrangencia])
  @@index([uf])
  @@index([data])
  @@map("calendario_feriados")
}

model Notificacao {
  id            String      @id @default(uuid()) @db.Uuid
  usuarioId     String      @map("usuario_id") @db.Uuid
  titulo        String // título curto da notificação
  mensagem      String // mensagem completa
  tipoEventoId  String?     @map("tipo_evento_id") @db.Uuid
  tipoEvento    TipoEvento? @relation(fields: [tipoEventoId], references: [id])
  eventoId      String?     @map("evento_id") @db.Uuid // pode apontar para CalendarioEvento ou CalendarioObrigacao
  tipoAlerta    TipoAlerta  @map("tipo_alerta") // UM_DIA_ANTE ou NO_DIA
  lida          Boolean     @default(false)
  dataEnvio     DateTime    @default(now()) @map("data_envio")
  dataExpiracao DateTime?   @map("data_expiracao") // notificacao expira após X tempo
  metadata      Json?       @default("{}") // dados extras (url do evento, etc.)
  createdAt     DateTime    @default(now()) @map("created_at")
  usuario       User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([lida])
  @@index([tipoAlerta])
  @@index([dataEnvio])
  @@index([dataExpiracao])
  @@map("notificacoes")
}

// Agendamentos de Robôs (RPA)
model AgendamentoRpa {
  id              String                 @id @default(uuid()) @db.Uuid
  usuarioId       String                 @map("usuario_id") @db.Uuid
  nome            String // nome descritivo do agendamento
  tipoRobo        TipoRobo               @map("tipo_robo") // SIMPLES_NACIONAL ou SEFAZ_BA
  cnpj            String // CNPJ alvo
  recorrencia     RecorrenciaAgendamento // unica, diaria, semanal, mensal, x_vezes_dia, x_vezes_semana
  diasSemana      Int?                   @map("dias_semana") // [0-6] para semanal (0=domingo)
  horaExecucao    String                 @map("hora_execucao") // "HH:MM" formato 24h
  vezesPorDia     Int                    @default(1) @map("vezes_por_dia")
  vezesPorSemana  Int                    @default(0) @map("vezes_por_semana")
  proximaExecucao DateTime?              @map("proxima_execucao")
  ativo           Boolean                @default(true)
  ultimoResultado Json?                  @default("{}") @map("ultimo_resultado")
  totalExecucoes  Int                    @default(0) @map("total_execucoes")
  criadoPorId     String?                @map("criado_por_id") @db.Uuid
  criadoPor       User?                  @relation("AgendamentoCriadoPor", fields: [criadoPorId], references: [id])
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  usuario         User                   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ativo])
  @@index([tipoRobo])
  @@index([recorrencia])
  @@index([proximaExecucao])
  @@map("agendamentos_rpa")
}

enum TipoRobo {
  SIMPLES_NACIONAL
  SEFAZ_BA
}

enum RecorrenciaAgendamento {
  unica
  diaria
  semanal
  mensal
  x_vezes_dia
  x_vezes_semana
}

// API Keys para acesso externo ao sistema
model ApiKey {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  nome             String // nome descritivo da chave
  chave            String    @unique // token hash da API key
  prefixo          String // primeiros 8 caracteres para exibicao (sk_live_...)
  permissoes       Json      @default("[]") // ["read:clientes", "write:documentos", etc]
  ultimaUtilizacao DateTime? @map("ultima_utilizacao")
  totalRequisicoes Int       @default(0) @map("total_requisicoes")
  expiraEm         DateTime? @map("expira_em") // null = nunca expira
  ativa            Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  usuario          User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ativa])
  @@index([chave])
  @@map("api_keys")
}

// Configuração de APIs de consulta CNPJ
model CnpjApiConfig {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String   @unique // slug: "opencnpj", "invertexto", etc.
  label          String // nome exibível: "OpenCNPJ", "Invertexto"
  url            String // endpoint base
  ativa          Boolean  @default(true)
  ordem          Int // ordem de execução (menor = primeiro)
  consomeCredito Boolean  @default(false) // se consome créditos pagos
  timeout        Int      @default(5000) // timeout em ms
  cbThreshold    Int      @default(5) // circuit breaker threshold
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([ordem])
  @@index([ativa])
  @@map("cnpj_api_config")
}
